---
// Props : title, description, current (id de la page courante, voir src/lib/pages.js).
import "../styles/global.css";
import { pages } from "../lib/pages.js";

const { title = "Comprendre l'électricité de l'IA", description = "", current = "" } = Astro.props;
const i = pages.findIndex((p) => p.id === current);
const prev = i > 0 ? pages[i - 1] : null;
const next = i >= 0 && i < pages.length - 1 ? pages[i + 1] : null;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body data-page={current}>
    <script>
      import "../scripts/lenis.js";
      import "../scripts/animations.js";
    </script>
    <a href="#contenu" class="saut">Aller au contenu</a>

    <header class="entete">
      <div class="entete-haut">
        <a href="/" class="marque">
          <span aria-hidden="true" class="pastilles"></span>
          <span>Comprendre l'électricité de l'IA</span>
        </a>
        <span class="credit">Open Data University × ADEME</span>
      </div>
      <nav aria-label="Chapitres" class="chapitres">
        {pages.map((p) => (
          <a href={p.href} aria-current={p.id === current ? "page" : undefined} class:list={["chapitre", { actif: p.id === current }]}>
            {p.num && <span class="num">{p.num}</span>}{p.label}
          </a>
        ))}
      </nav>
    </header>

    <main id="contenu">
      <slot />
    </main>

    {(prev || next) && (
      <nav aria-label="Page précédente et suivante" class="pagination">
        <div class="pagination-grille">
          {prev ? <a href={prev.href} class="carte-nav"><span class="sens">← Précédent</span><span class="titre">{prev.title}</span></a> : <span></span>}
          {next && <a href={next.href} class="carte-nav suivant"><span class="sens">Suivant →</span><span class="titre">{next.title}</span></a>}
        </div>
      </nav>
    )}

    <footer class="pied">
      <div class="pied-contenu">
        <div class="pied-bloc"><strong>Sources et licences</strong><span>AI Energy Score · Apache-2.0</span><span>Compar:IA · Licence Ouverte 2.0</span></div>
        <div class="pied-bloc"><strong>Équipe</strong><span>Thomas Perruchot</span><span>Bambou Franceschini</span></div>
        <div class="pied-bloc">
          <strong>Projet</strong><span>BUT MMI · SAÉ 303</span>
          <span>Défi «&nbsp;Impact environnemental de l'IA générative&nbsp;», Open Data University × ADEME</span>
          <a href="/methode">Méthode et sources</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  .saut { position: absolute; left: 8px; top: -60px; z-index: 100; background: #fff; padding: 10px 14px; border-radius: 8px; }
  .saut:focus { top: 8px; }
  .entete { position: sticky; top: 0; z-index: 40; background: #fff; border-bottom: 1px solid var(--color-line); }
  .entete-haut { max-width: 1320px; margin: 0 auto; padding: 0 20px; display: flex; align-items: center; justify-content: space-between; gap: 16px; height: 52px; border-bottom: 1px solid var(--color-soft); }
  .marque { font-family: var(--font-serif); font-weight: 700; font-size: clamp(16px, 4.6vw, 20px); color: var(--color-ink); text-decoration: none; white-space: nowrap; display: flex; align-items: center; gap: 16px; min-width: 0; }
  .marque span:last-child { overflow: hidden; text-overflow: ellipsis; }
  .pastilles { flex: none; }
  .pastilles { width: 14px; height: 14px; border-radius: 50%; background: #8e6ff0; box-shadow: 8px 0 0 #6a3fd9; }
  .credit { font-size: 13px; color: #555; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  @media (max-width: 640px) { .credit { display: none; } }
  .chapitres { max-width: 1320px; margin: 0 auto; padding: 0 8px; display: flex; overflow-x: auto; scrollbar-width: none; }
  .chapitre { position: relative; isolation: isolate; flex: none; display: flex; align-items: center; gap: 6px; height: 46px; padding: 0 12px; font-size: 15px; font-weight: 500; color: #111; text-decoration: none; white-space: nowrap; }
  .chapitre:first-child { margin-left: auto; }
  .chapitre:last-child { margin-right: auto; }
  .chapitre:hover { color: var(--color-primary); }
  .chapitre .num { font-size: 13px; color: #555; }
  .chapitre.actif::before { content: ""; position: absolute; z-index: -1; inset: 8px 4px; border-radius: 999px; background: var(--color-soft); box-shadow: inset 0 0 0 1.5px #8e6ff0; }
  main { min-height: 70vh; }
  .pagination { max-width: 1320px; margin: clamp(56px, 7vw, 88px) auto 0; padding: 0 20px; }
  .pagination-grille { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 12px; }
  .carte-nav { display: flex; flex-direction: column; gap: 2px; padding: 20px 24px; border-radius: 20px; background: var(--color-soft); color: var(--color-ink); text-decoration: none; transition: transform 0.25s, background 0.25s; }
  .carte-nav:hover { background: var(--color-line); color: var(--color-ink); transform: translateY(-3px); }
  .carte-nav.suivant { grid-column: -2; align-items: flex-end; text-align: right; }
  .carte-nav .sens { font-size: 14px; color: #555; }
  .carte-nav .titre { font-family: var(--font-serif); font-weight: 600; font-size: 20px; }
  .pied { margin-top: 56px; background: var(--color-ink); border-radius: 32px 32px 0 0; padding: 48px 20px 40px; font-size: 15px; color: #e9e3ff; }
  .pied-contenu { max-width: 1320px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 24px 40px; }
  .pied-bloc { display: flex; flex-direction: column; gap: 6px; }
  .pied-bloc strong { color: #fff; }
  .pied a { color: var(--color-accent); }
</style>
