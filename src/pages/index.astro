---
import Layout from "../layouts/Layout.astro";
import { pages } from "../lib/pages.js";

const toc = pages.slice(1, 6);
const barres = [[38, "#C9B8F5"], [62, "#8E6FF0"], [46, "#C9B8F5"], [80, "#6A3FD9"], [54, "#8E6FF0"], [92, "#C9B8F5"], [70, "#E0457B"], [40, "#8E6FF0"], [100, "#C9B8F5"], [66, "#6A3FD9"], [48, "#8E6FF0"], [84, "#C9B8F5"], [58, "#E0457B"], [36, "#8E6FF0"], [74, "#C9B8F5"], [52, "#8E6FF0"], [88, "#6A3FD9"], [44, "#C9B8F5"], [64, "#8E6FF0"], [30, "#C9B8F5"]];
const natures = [
  { nom: "Mesuré", couleur: "var(--data-mesure)", texte: "On fait tourner le modèle sur une machine et on lit le compteur électrique.", exemple: "AI Energy Score mesure chaque modèle en laboratoire, tâche par tâche." },
  { nom: "Estimé", couleur: "var(--data-estime)", texte: "On calcule la consommation à partir de caractéristiques connues, sans la mesurer.", exemple: "Compar:IA estime la consommation de chaque conversation d'après la taille du modèle." },
  { nom: "Déclaré", couleur: "var(--data-neutre)", texte: "Quelqu'un signale une information, sans qu'elle soit vérifiée par une mesure.", exemple: "Sur OpenStreetMap, des contributeurs indiquent l'emplacement des centres de données." },
];
---

<Layout title="L'électricité de l'IA" description="Ce que mesure le laboratoire, est-ce ce que consomment nos vraies conversations ? Un parcours pour apprendre à lire les chiffres sur la consommation électrique de l'IA." current="accueil">
  <div class="page">
    <section class="une">
      <span aria-hidden="true" class="rond-1"></span>
      <span aria-hidden="true" class="rond-2"></span>
      <div class="texte">
        <span class="badge">Enquête · Impact environnemental de l'IA générative</span>
        <h1>L'électricité de l'IA&nbsp;: ce que mesure le laboratoire, est-ce ce que consomment nos vraies conversations&nbsp;?</h1>
        <p class="chapo">Les chiffres sur la consommation électrique de l'IA circulent beaucoup, mais ils ne mesurent pas tous la même chose. En quatre visualisations, ce parcours vous apprend à les lire.</p>
        <div class="actions">
          <a href="/requete" class="bouton">Commencer la lecture →</a>
          <span class="auteurs">Par <strong>Xavier Senente, Thomas Perruchot et Bambou Franceschini</strong> · BUT MMI, SAÉ 303</span>
        </div>
      </div>
      <div aria-hidden="true" class="barres">
        {barres.map(([h, c]) => <span style={`height:${h}%;background:${c}`}></span>)}
      </div>
    </section>

    <section class="bloc">
      <h2>D'où vient un chiffre&nbsp;?</h2>
      <p>Un chiffre sur l'électricité de l'IA peut être mesuré, estimé ou déclaré. Ces trois natures ne donnent pas la même confiance.</p>
      <div class="cartes">
        {natures.map((n) => (
          <div class="carte">
            <h3><span class="point" style={`background:${n.couleur}`}></span>{n.nom}</h3>
            <p>{n.texte}</p>
            <p class="exemple">Exemple&nbsp;: {n.exemple}</p>
          </div>
        ))}
      </div>
      <p class="note">Dans les graphiques, le violet désigne une mesure du laboratoire, le framboise une estimation Compar:IA, le gris l'absence de donnée.</p>
    </section>

    <section class="bloc">
      <h2 class="surtitre">Au sommaire</h2>
      <ol class="sommaire">
        {toc.map((p) => (
          <li>
            <a href={p.href}>
              <span class="rond">{p.num || "—"}</span>
              <span class="titre">{p.title}</span>
              <span aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  </div>
</Layout>

<style>
  .une { position: relative; isolation: isolate; overflow: hidden; border-radius: 32px; background: var(--color-ink); color: #fff; padding: clamp(32px, 6vw, 80px) clamp(24px, 5vw, 72px) 0; display: flex; flex-direction: column; gap: clamp(40px, 6vw, 72px); }
  .rond-1 { position: absolute; z-index: -1; right: -140px; top: -160px; width: 440px; height: 440px; border-radius: 50%; background: #4a2bb0; }
  .rond-2 { position: absolute; z-index: -1; right: 110px; top: 150px; width: 150px; height: 150px; border-radius: 50%; border: 2px solid var(--color-accent); }
  .texte { max-width: 820px; display: flex; flex-direction: column; gap: 22px; }
  .badge { align-self: flex-start; padding: 6px 14px; border-radius: 999px; background: var(--color-accent); color: var(--color-ink); font-size: 13px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; }
  h1 { margin: 0; font-family: var(--font-serif); font-weight: 600; font-size: clamp(34px, 5vw, 60px); line-height: 1.08; letter-spacing: -0.01em; color: #fff; text-wrap: balance; }
  .chapo { margin: 0; font-family: var(--font-serif); font-size: clamp(20px, 2vw, 23px); line-height: 1.45; color: #e9e3ff; text-wrap: pretty; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 24px; padding-top: 8px; }
  .bouton { display: inline-flex; align-items: center; height: 52px; padding: 0 26px; border-radius: 999px; background: #fff; color: var(--color-ink); font-weight: 600; text-decoration: none; transition: transform 0.2s, background 0.2s; }
  .bouton:hover { background: var(--color-accent); color: var(--color-ink); transform: translateX(4px); }
  .auteurs { font-size: 15px; color: var(--color-line); }
  .auteurs strong { color: #fff; font-weight: 600; }
  .barres { display: flex; align-items: flex-end; gap: clamp(5px, 1vw, 12px); height: clamp(90px, 13vw, 160px); }
  .barres span { flex: 1; border-radius: 999px 999px 0 0; transform-origin: center bottom; animation: monte 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
  @keyframes monte { from { transform: scaleY(0); } }
  .bloc { margin-top: clamp(48px, 6vw, 80px); display: flex; flex-direction: column; gap: 20px; }
  h2 { margin: 0; font-family: var(--font-serif); font-weight: 700; font-size: clamp(26px, 3vw, 34px); line-height: 1.15; }
  .bloc > p { margin: 0; max-width: 720px; }
  .cartes { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 16px; }
  .carte { padding: 28px; border-radius: 24px; background: var(--color-softer); display: flex; flex-direction: column; gap: 10px; transition: transform 0.25s, box-shadow 0.25s; }
  .carte:hover { transform: translateY(-4px); box-shadow: 0 12px 28px rgba(42, 20, 117, 0.12); }
  .carte h3 { margin: 0; display: flex; align-items: center; gap: 10px; font-size: 20px; font-weight: 700; }
  .carte p { margin: 0; }
  .point { width: 16px; height: 16px; border-radius: 50%; }
  .exemple, .note { font-size: 16px; color: #555; }
  .note { font-size: 15px; }
  .surtitre { font-family: var(--font-sans); font-size: 14px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: #555; }
  .sommaire { margin: 0; padding: 0; list-style: none; border-top: 2px solid var(--color-ink); }
  .sommaire li { border-bottom: 1px solid #e3e3e3; }
  .sommaire a { display: grid; grid-template-columns: 44px minmax(0, 1fr) auto; gap: 16px; align-items: center; padding: 16px 0; color: #111; text-decoration: none; }
  .sommaire a:hover { color: var(--color-primary); }
  .rond { display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 50%; background: var(--color-soft); color: var(--color-primary); font-weight: 700; font-size: 15px; }
  .titre { font-family: var(--font-serif); font-weight: 600; font-size: clamp(19px, 2vw, 23px); line-height: 1.3; }
  @media (prefers-reduced-motion: reduce) { .barres span { animation: none; } }
</style>
