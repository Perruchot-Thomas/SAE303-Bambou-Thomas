---
// V1 · Route d'export A : rendu au BUILD, HTML/CSS statique sans JavaScript.
// Pourquoi : rien ne doit bouger chez le lecteur, la figure est la même pour tout le monde.
import { taches } from "../../lib/donnees.js";
import { duree, posDuree } from "../../lib/format.js";

const lignes = taches.map((t) => ({ ...t, x: posDuree(t.secondes), v: duree(t.secondes) }));
const reperes = [[1, "1 s"], [10, "10 s"], [60, "1 min"], [600, "10 min"], [3600, "1 h"]];
const alt = `Graphique de barres horizontales : une barre par tâche, de la plus gourmande (${lignes[0].libelle}, ${lignes[0].v}) à la plus sobre (${lignes.at(-1).libelle}, ${lignes.at(-1).v}) d'ampoule LED allumée. L'échelle est logarithmique.`;
---

<figure class="viz" aria-labelledby="v1-legende">
  <div class="lire">
    <strong>Comment lire ce graphique</strong>
    <p>
      Chaque barre est une tâche demandée à une IA. Sa longueur indique combien de temps une ampoule LED resterait allumée avec la même électricité.
      Les repères du bas ne sont pas espacés régulièrement&nbsp;: chacun représente une durée bien plus longue que le précédent, sinon les petites barres seraient invisibles.
    </p>
  </div>
  <p class="sr-only">{alt}</p>
  <ul class="rangs" role="list">
    {lignes.map((t) => (
      <li class="rang">
        <span class="nom">{t.libelle}</span>
        <span class="piste">
          <span class="barre" data-bar="x" style={`width:${t.x}%`}></span>
        </span>
        <span class="valeur">{t.v}</span>
      </li>
    ))}
  </ul>
  <div class="rang axe" aria-hidden="true">
    <span class="nom"></span>
    <span class="piste graduations">
      {reperes.map(([s, label]) => <span style={`left:${posDuree(s)}%`}>{label}</span>)}
    </span>
    <span class="valeur"></span>
  </div>
  <figcaption id="v1-legende">
    Source&nbsp;: AI Energy Score, mesuré en laboratoire (décembre 2025 pour le texte et le raisonnement). Valeur du modèle «&nbsp;du milieu&nbsp;» de chaque tâche,
    énergie des GPU seulement. Conversion&nbsp;: 1&nbsp;Wh = ampoule LED de 10&nbsp;W allumée 6&nbsp;minutes.
  </figcaption>
</figure>

<style>
  .viz { margin: 40px 0 0; padding-top: 20px; border-top: 3px solid var(--color-ink, #2a1475); display: flex; flex-direction: column; gap: 20px; }
  .lire { max-width: 760px; display: flex; flex-direction: column; gap: 4px; }
  .lire strong { font-size: 15px; }
  .lire p { margin: 0; font-size: 16px; color: #333; }
  .rangs { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 8px; }
  .rang { display: grid; grid-template-columns: minmax(150px, 1fr) 3fr 76px; gap: 10px 20px; align-items: center; }
  .nom { font-size: 16px; }
  .piste { display: block; height: 22px; border-left: 1px solid #111; }
  .barre { display: block; height: 100%; background: var(--data-mesure, #6a3fd9); transform-origin: left center; animation: pousse 1.1s cubic-bezier(.2, .7, .2, 1) both; }
  .valeur { font-size: 15px; font-weight: 600; font-variant-numeric: tabular-nums; }
  .axe { margin-top: -4px; }
  .graduations { position: relative; height: 28px; border-left: 0; border-top: 1px solid #111; font-size: 13px; color: #555; }
  .graduations span { position: absolute; top: 5px; transform: translateX(-50%); }
  .graduations span:last-child { transform: translateX(-100%); }
  figcaption { padding-top: 10px; border-top: 1px solid #e3e3e3; font-size: 14px; color: #555; }
  @keyframes pousse { from { transform: scaleX(0); } }
  @media (prefers-reduced-motion: reduce) { .barre { animation: none; } }
  @media (max-width: 640px) {
    .rang { grid-template-columns: 1fr 64px; }
    .nom { grid-column: 1 / -1; }
    .axe .nom { display: none; }
  }
</style>
